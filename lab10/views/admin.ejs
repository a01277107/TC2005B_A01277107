<!DOCTYPE html>
<html>
  <%- include('includes/head') %>
  <body>
    <h1>Panel de Administrador</h1>
    <% if (clientes.length > 0) { %>
      <table class="table">
        <thead>
          <tr><th>Nombre</th><th>Correo</th><th>Puntos</th></tr>
        </thead>
        <tbody>
          <% clientes.forEach(c => { %>
            <tr>
              <td><%= c.nombre %></td>
              <td><%= c.correo %></td>
              <td><%= c.puntos %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p>No hay clientes registrados aún.</p>
    <% } %>

    <%- include('includes/footer') %>
  </body>
</html>
