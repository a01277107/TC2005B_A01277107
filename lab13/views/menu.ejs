<!DOCTYPE html>
<html>
  <%- include('includes/head') %>
  <body>
    <h1><%= pageTitle %></h1>
    <div class="menu">
      <% if (productos.length > 0) { %>
        <% productos.forEach(p => { %>
          <div class="card">
            <h3><%= p.nombre %></h3>
            <p>$<%= p.precio %></p>
          </div>
        <% }) %>
      <% } else { %>
        <p>No hay productos en el menú.</p>
      <% } %>
    </div>
    <%- include('includes/footer') %>
  </body>
</html>
