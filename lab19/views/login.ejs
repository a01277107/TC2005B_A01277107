<!DOCTYPE html>
<html lang="es">
  <%- include('includes/head') %>
  <body>
    <main class="page page-center auth-page">
      <section class="panel panel-login auth-panel">
        <p class="eyebrow">MAREÉ CREPE</p>
        <h1>Inicia sesión</h1>
        <p class="subtitle">Accede a tu menú, recompensas y panel de administración.</p>

        <% if (error) { %>
          <div class="message-error"><%= error %></div>
        <% } %>

        <form action="/login" method="POST" class="form-card auth-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <label for="username">Usuario</label>
          <input id="username" type="text" name="username" placeholder="Tu usuario" required>

          <label for="password">Contraseña</label>
          <input id="password" type="password" name="password" placeholder="Tu contraseña" required>

          <button type="submit">Entrar</button>
        </form>

        <p class="mini-text auth-switch">¿No tienes cuenta? <a href="/register">Regístrate aquí</a></p>
      </section>
    </main>
  </body>
</html>
